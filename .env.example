# ---------------------------------------------------------------
# Database (required) — any PostgreSQL 14+ (local, Docker, Supabase, Neon, RDS…)
# Supabase: Project Settings → Database → Connection string (use the
# "Session pooler" URI for serverless hosts) and set DATABASE_SSL=true.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/travel_journal
DATABASE_SSL=false

# ---------------------------------------------------------------
# Photo storage: "local" (files on disk) or "s3" (any S3-compatible bucket:
# Supabase Storage, AWS S3, Cloudflare R2, Backblaze B2, MinIO…)
STORAGE_DRIVER=local
# local driver: directory for uploaded photos (must be a persistent volume in production)
STORAGE_DIR=./storage/uploads

# s3 driver (only read when STORAGE_DRIVER=s3)
# Supabase Storage: Storage → Settings → S3 Connection. Endpoint looks like
#   https://<project-ref>.supabase.co/storage/v1/s3   and region e.g. us-east-1
# Create a PRIVATE bucket (e.g. "photos") first; photos are always served through the app.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Max upload size per photo, in megabytes
MAX_UPLOAD_MB=25

# ---------------------------------------------------------------
# Auth: the first person to sign up becomes the owner. After that sign-up
# is closed unless you set ALLOW_SIGNUP=true.
ALLOW_SIGNUP=false
# Set to false only if you serve the app over plain http (e.g. on a LAN)
SECURE_COOKIES=true

# ---------------------------------------------------------------
# Map basemap. By default the maps show streets and place names from
# OpenFreeMap (free, no key). Use another MapLibre style URL to change it, or
# "none" for the plain built-in atlas style. Read at build time.
#   NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_STYLE_URL=
